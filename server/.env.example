# Copy this file to .env and fill in your own values.
# Never commit .env — it contains passwords.

# MongoDB Atlas connection string (development database).
# Get the real one privately from a teammate, or from Atlas → Connect → Drivers.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tripplanner?retryWrites=true&w=majority

# Secret used to sign login tokens (JWT). At least 32 characters, the server does not start without it.
# Generate your own (never reuse the one from Render):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Address of the React client allowed to call the server (CORS), comma-separated if more.
# Locally the default http://localhost:5173 is enough; on Render set it to the Vercel address.
CLIENT_URL=http://localhost:5173

# Optional: photos from Google Maps for stays whose page gives none (Booking). A Places API (New) key
# from Google Cloud, restricted to the Places API. Without it the cards simply have no photo then.
# GOOGLE_PLACES_KEY=

# Optional: e-mails (the link that confirms a new e-mail address) are sent through Resend. An API key from
# https://resend.com (free plan: 100 e-mails a day). Without it the e-mail is written to the server's log instead.
# MAIL_FROM is the sender; without a verified domain of our own leave it out, and Resend's test sender
# onboarding@resend.dev is used, which only delivers to the e-mail address of the Resend account.
# RESEND_API_KEY=
# MAIL_FROM=TripPlanner <hello@your-domain.dk>

# Optional: photos of the destination on the trip cards, from Unsplash. The Access Key of an app made for free at
# https://unsplash.com/developers. Without it the cards have a coloured background instead.
# UNSPLASH_ACCESS_KEY=

# Optional, only if the server fails with "querySrv ECONNREFUSED" (some Windows machines).
# Makes Node use these DNS servers to find the database. Do not set it on Render.
# DNS_SERVERS=8.8.8.8,1.1.1.1
