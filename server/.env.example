# Copy this file to .env and fill in your own values.
# Never commit .env — it contains passwords.

# MongoDB Atlas connection string (development database).
# Get the real one privately from a teammate, or from Atlas → Connect → Drivers.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tripplanner?retryWrites=true&w=majority

# Secret used to sign login tokens (JWT). At least 32 characters, the server does not start without it.
# Generate your own (never reuse the one from Render):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Address of the React client allowed to call the server (CORS), comma-separated if more.
# Locally the default http://localhost:5173 is enough; on Render set it to the Vercel address.
CLIENT_URL=http://localhost:5173
